-- recreate database
DROP DATABASE IF EXISTS moviedb;
CREATE DATABASE moviedb;
USE moviedb;

-- allow updates without safe mode (if needed)
SET SQL_SAFE_UPDATES = 0;

-- ---------- Movie reviews (new values) ----------
-- clear if needed
TRUNCATE TABLE IF EXISTS movie_reviews;

INSERT INTO movie_reviews (movie_id, user_id, rating, comment, createdAt) VALUES
-- Reviews for "Midnight Runner" (movie_id 1)
(1, 2, 5, 'Edge-of-your-seat thrills and great choreography. Loved it!', NOW()),
(1, 3, 4, 'Very entertaining, pacing a bit fast but what a ride!', NOW()),
-- Reviews for "Starlight Sonata" (movie_id 4)
(4, 1, 5, 'Beautiful, emotional, and musically superb — a modern classic.', NOW()),
(4, 5, 5, 'Brought tears to my eyes, exceptional performances.', NOW()),
-- Reviews for "The Last Harbor" (movie_id 7)
(7, 2, 4, 'Strong drama, believable characters and solid cinematography.', NOW()),
(7, 3, 4, 'Good story but slow near the middle.', NOW()),
-- Reviews for "Neon City" (movie_id 10)
(10, 4, 3, 'Visually great but narrative felt thin.', NOW()),
(10, 5, 4, 'Cool aesthetics and decent acting.', NOW());

SELECT * FROM movie_reviews;

-- ---------- Movies (new values) ----------
-- delete existing if necessary, but be careful in prod
-- DELETE FROM movies; ALTER TABLE movies AUTO_INCREMENT = 1;

INSERT INTO movies (title, language, genre, duration, description, posterUrl, trailerUrl) VALUES
('Midnight Runner', 'English', 'Action,Thriller', 118, 'A former detective races through the city to stop a planned attack while confronting his past.', 'https://example.com/posters/midnight_runner.jpg', 'https://www.youtube.com/embed/sample_trailer_midnight'),
('Blue Orchid', 'English', 'Romance,Drama', 125, 'Two strangers meet on a cross-country train and end up changing each other''s lives forever.', 'https://example.com/posters/blue_orchid.jpg', 'https://www.youtube.com/embed/sample_trailer_blueorchid'),
('Echoes of Time', 'English', 'Sci-Fi,Drama', 140, 'Scientists discover a way to listen to echoes from the future — consequences are unexpected.', 'https://example.com/posters/echoes_of_time.jpg', 'https://www.youtube.com/embed/sample_trailer_echoes'),
('Starlight Sonata', 'English', 'Drama,Music', 132, 'A gifted pianist struggles with fame, love, and the cost of genius.', 'https://example.com/posters/starlight_sonata.jpg', 'https://www.youtube.com/embed/sample_trailer_starlight'),
('Golden Fields', 'Hindi', 'Drama,Family', 145, 'A rural farming family fights to save its land and legacy against corporate interests.', 'https://example.com/posters/golden_fields.jpg', 'https://www.youtube.com/embed/sample_trailer_golden'),
('Shadow Protocol', 'English', 'Action,Sci-Fi', 110, 'A covert team must stop a rogue AI using guerrilla tactics across major cities.', 'https://example.com/posters/shadow_protocol.jpg', 'https://www.youtube.com/embed/sample_trailer_shadow'),
('The Last Harbor', 'English', 'Drama,Thriller', 128, 'A small coastal town harbors secrets that unravel when a stranger arrives.', 'https://example.com/posters/last_harbor.jpg', 'https://www.youtube.com/embed/sample_trailer_harbor'),
('Whispering Pines', 'English', 'Horror,Mystery', 100, 'Visitors to an isolated lodge begin to experience strange whispers and disappearances.', 'https://example.com/posters/whispering_pines.jpg', 'https://www.youtube.com/embed/sample_trailer_whisper'),
('Summer & Salt', 'Spanish', 'Romance,Comedy', 95, 'A light-hearted romance set in a seaside village during one unforgettable summer.', 'https://example.com/posters/summer_salt.jpg', 'https://www.youtube.com/embed/sample_trailer_summersalt'),
('Neon City', 'English', 'Sci-Fi,Action', 118, 'A neon-lit metropolis where hackers and street racers battle corporate overlords.', 'https://example.com/posters/neon_city.jpg', 'https://www.youtube.com/embed/sample_trailer_neon');

SELECT * FROM movies;

